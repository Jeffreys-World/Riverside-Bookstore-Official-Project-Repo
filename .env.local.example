# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Safe for client-side use (NEXT_PUBLIC_ prefix) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- SERVER-ONLY. Never import these into a file marked 'use client'. ---
# Bypasses Row-Level Security entirely. Used only by:
#   - app/api/live/execute-tool/route.ts (mutating Live API tool calls)
#   - the pre-order expiration edge function (Product A) — give this one
#     an extra self-review pass, since it mutates shared stock_quantity
#     and there's no second reviewer (see Solo Build Plan Section 1)
# See lib/supabase.ts, getServiceRoleClient(), for the enforced usage rule.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by app/api/live/token/route.ts to mint ephemeral Live API
# tokens. The browser only ever receives the short-lived ephemeral token
# this route returns — never this key itself.
GOOGLE_API_KEY=your-gemini-api-key

# Optional: override the default Live API model. See the TODO comment in
# app/api/live/token/route.ts — verify the current model name against
# https://ai.google.dev/gemini-api/docs/live-api before shipping.
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
